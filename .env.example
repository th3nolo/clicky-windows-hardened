# ============================================================
# Clicky for Windows - process environment variable reference
# ============================================================
# The hardened build NEVER loads this file. Set required values directly in
# the trusted parent process or Windows environment before launching Clicky.
# Do not place credentials in the repository or Clicky preferences.

# LLM provider credentials (all optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Speech-to-text provider credentials (optional)
DEEPGRAM_API_KEY=
# OPENAI_API_KEY also enables OpenAI speech-to-text.

# Local speech models are never downloaded. Provision reviewed artifacts first.
# The faster-whisper model/path is selected in Clicky preferences; its model.bin
# must match this exact digest before it can load.
WHISPER_MODEL_SHA256=<64-hex-sha256-of-model-bin>

# whisper.cpp requires an explicit reviewed local GGML/GGUF file and its digest.
WHISPERCPP_MODEL=<absolute-path-to-reviewed-ggml-or-gguf-file>
WHISPERCPP_MODEL_SHA256=<64-hex-sha256-of-ggml-or-gguf-file>

# Wake-word detection requires a separate reviewed faster-whisper model directory.
CLICKY_WAKE_MODEL=<absolute-path-to-reviewed-faster-whisper-model-directory>
CLICKY_WAKE_MODEL_SHA256=<64-hex-sha256-of-wake-model-bin>

# Text-to-speech provider credential (optional)
ELEVENLABS_API_KEY=

# Web search provider credential (optional; search defaults off)
TAVILY_API_KEY=

# Ollama is not an automatic fallback. It must already be running on the fixed
# loopback endpoint, and both models selected in Clicky must match exact local
# digests. Inspect full values with: python -m ai.ollama_bootstrap status
OLLAMA_VISION_MODEL_DIGEST=<64-hex-digest-from-local-api-tags>
OLLAMA_TEXT_MODEL_DIGEST=<64-hex-digest-from-local-api-tags>
